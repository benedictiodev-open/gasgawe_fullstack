    "paths": {
        "/masterdata/province": {
            "get": {
                "tags": [
                    "Masterdata"
                ],
                "summary": "Get all provinces",
                "description": "Retrieve a list of all provinces in Indonesia.",
                "operationId": "40f50aab86f712ec6f6295e335cfbf2f",
                "responses": {
                    "200": {
                        "description": "Provinces retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "string",
                                                        "example": "11"
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "ACEH"
                                                    },
                                                    "meta": {
                                                        "type": "object"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/masterdata/cities/{id}": {
            "get": {
                "tags": [
                    "Masterdata"
                ],
                "summary": "Get cities by province ID",
                "description": "Retrieve a list of cities for a specific province.",
                "operationId": "f46a0c37b9a573c8ac2dbe6c6f75545b",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Province ID",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "11"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cities retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "string",
                                                        "example": "1101"
                                                    },
                                                    "province_id": {
                                                        "type": "string",
                                                        "example": "11"
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "KABUPATEN SIMEULUE"
                                                    },
                                                    "meta": {
                                                        "type": "object"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/masterdata/skill": {
